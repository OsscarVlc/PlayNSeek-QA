# Conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/playnseek

# Llave para firmar los JWT (cualquier texto largo y aleatorio)
JWT_SECRET=cambia_esto_por_un_secreto_largo

# API de juegos RAWG (https://rawg.io/apidocs)
RAWG_KEY=tu_llave_de_rawg

# Cuenta de Gmail para los correos de confirmación (usar contraseña de aplicación)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion

# Cloudinary, para imágenes de perfil y posts
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# URL pública del back (se usa en el enlace del correo de confirmación)
APP_URL=http://localhost:3000

# Origen permitido por CORS (el front)
FRONT_URL=http://localhost:4200

# Puerto del servidor
PORT=3000